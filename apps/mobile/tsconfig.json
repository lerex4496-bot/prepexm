{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Tests are Node programs and use Node's globals. They are type-checked by
  // tsconfig.jest.json, which adds those types; leaving them in here would
  // mean either failing this check or letting app code reach for `Buffer`.
  "exclude": ["node_modules", "**/__tests__/**"]
}
