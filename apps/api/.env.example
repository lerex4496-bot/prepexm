# Copy to .env and fill in. THIS FILE IS COMMITTED — never put a real key here.
#
# .gitignore un-ignores this file on purpose (`!.env.example`), so anything
# written below ends up in the repository history, where a key cannot be
# un-published.

SARVAM_API_KEY=your_sarvam_key_here
SARVAM_MODEL=sarvam-105b-conversations

NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

LLM_PROVIDER=nvidia
LLM_PROVIDER_INDIC=sarvam

# Signs session tokens for the optional student account. Any long random
# string. If unset, tokens are signed with a per-process key and everyone is
# signed out when the server restarts.
STUDYMATE_SECRET=
